---
title: ''
date: 2024-01-01 00:00:00
comments: false
top_img: false
aside: false
---

<div class="home-page">
  <section class="hero">
    <div class="hero-avatar-wrap">
      <img src="/img/avater.jpg" alt="Randolfluo" class="hero-avatar">
    </div>
    <h1 class="hero-title">Randolfluo</h1>
    <div class="typewriter">
      <span id="type-text"></span><span class="cursor">|</span>
    </div>
    <div class="hero-actions">
      <a href="/blog/" class="btn btn-main">
        <i class="fas fa-book-open"></i> 浏览文章
      </a>
      <a href="/about/" class="btn btn-ghost">
        <i class="fas fa-user"></i> 关于我
      </a>
    </div>
  </section>

  <div class="divider"></div>

  <section class="quote">
    <div class="quote-inner">
      <div class="quote-seal"></div>
      <blockquote>今日事，今日毕</blockquote>
    </div>
  </section>

  <div class="divider"></div>

  <section class="widgets">
    <div class="widget-card ip-widget">
      <div class="widget-header">
        <h3><i class="fas fa-network-wired"></i> 访问信息</h3>
        <span class="widget-num">01</span>
      </div>
      <div class="widget-content">
        <div class="ip-address">获取中...</div>
        <div class="ip-location">--</div>
      </div>
    </div>
    <div class="widget-card weather-widget">
      <div class="widget-header">
        <h3><i class="fas fa-cloud-sun"></i> 当地天气</h3>
        <span class="widget-num">02</span>
      </div>
      <div class="widget-content">
        <div class="weather-temp">--</div>
        <div class="weather-desc">--</div>
      </div>
    </div>
    <div class="widget-card pomodoro-widget">
      <div class="widget-header">
        <h3><i class="fas fa-clock"></i> 番茄钟</h3>
        <span class="widget-num">03</span>
      </div>
      <div class="widget-content">
        <div class="pomodoro-timer">25:00</div>
        <div class="pomodoro-controls">
          <button class="btn-pomo" id="pomo-start">开始</button>
          <button class="btn-pomo" id="pomo-pause">暂停</button>
          <button class="btn-pomo" id="pomo-reset">重置</button>
        </div>
      </div>
    </div>
  </section>

  <section class="api-widgets">
    <div class="widget-card api-card yiyan-widget">
      <div class="widget-header">
        <h3><i class="fas fa-quote-left"></i> 每日一言</h3>
        <span class="widget-num">04</span>
      </div>
      <div class="widget-content">
        <div class="yiyan-text">加载中...</div>
      </div>
    </div>
    <div class="widget-card api-card news-widget">
      <div class="widget-header">
        <h3><i class="fas fa-newspaper"></i> 60s 读世界</h3>
        <span class="widget-num">05</span>
      </div>
      <div class="widget-content">
        <div class="news-date">--</div>
        <ul class="news-list">加载中...</ul>
        <div class="news-tip"></div>
      </div>
    </div>
  </section>
</div>

<style>
@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Noto+Serif+SC:wght@400;600;700&family=Playfair+Display:wght@400;700&display=swap');

/* Hide nav, footer, sidebar — page-specific */
#nav,
#page-header,
.nav-fixed,
#sidebar,
#footer,
#footer-wrap,
.footer,
#aside-content,
.aside-content,
#rightside,
#pagination {
  display: none !important;
}

#body-wrap {
  padding-top: 0 !important;
}

#content-inner,
#content-inner .recent-posts,
.layout,
#article-container,
.page-home #page,
.page-home .content {
  width: 100% !important;
  max-width: 100% !important;
  padding: 0 !important;
  margin: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  border: none !important;
}

#body-wrap {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

#content-outer {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

#content-inner {
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-page {
  --bg: #f7f5f0;
  --bg-card: #faf9f7;
  --text-main: #1c1917;
  --text-muted: #78716c;
  --accent: #c41e3a;
  --accent-light: rgba(196, 30, 58, 0.06);
  --border: rgba(28, 25, 23, 0.1);
  --border-accent: rgba(196, 30, 58, 0.25);
  --font-serif: "Noto Serif SC", "Songti SC", "STSong", serif;
  --font-display: "Playfair Display", "Georgia", serif;
  --font-mono: "JetBrains Mono", "Fira Code", "Consolas", monospace;

  position: relative;
  overflow: hidden;
  width: 100%;
  max-width: 960px;
  margin: 0 auto;
  padding: 60px 24px;
  font-family: var(--font-serif);
  color: var(--text-main);
  background: var(--bg);
}

/* Subtle paper texture */
.home-page::before {
  content: "";
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.025'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 0;
}

[data-theme="dark"] .home-page {
  --bg: #0c0a09;
  --bg-card: #141211;
  --text-main: #e7e5e4;
  --text-muted: #a8a29e;
  --accent: #e11d48;
  --accent-light: rgba(225, 29, 72, 0.08);
  --border: rgba(231, 229, 228, 0.08);
  --border-accent: rgba(225, 29, 72, 0.3);
}

/* Divider */
.divider {
  height: 1px;
  background: var(--border);
  margin: 0 auto;
  max-width: 120px;
  position: relative;
  z-index: 1;
}

/* Hero */
.hero {
  text-align: center;
  padding: 40px 0 50px;
  position: relative;
  z-index: 1;
  animation: fadeInUp 0.9s ease-out;
}

.hero-avatar-wrap {
  display: inline-block;
  position: relative;
}

.hero-avatar {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid var(--accent);
  padding: 3px;
  background: var(--bg);
  transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
}

.hero-avatar-wrap::after {
  content: "";
  position: absolute;
  top: -6px;
  left: -6px;
  right: -6px;
  bottom: -6px;
  border-radius: 50%;
  border: 1px solid var(--border);
  transition: all 0.4s ease;
}

.hero-avatar-wrap:hover .hero-avatar {
  transform: scale(1.05);
}

.hero-avatar-wrap:hover::after {
  border-color: var(--accent);
  transform: scale(1.02);
}

.hero-title {
  font-family: var(--font-display);
  font-size: 2.8rem;
  font-weight: 700;
  margin: 24px 0 10px;
  letter-spacing: -0.02em;
  color: var(--text-main);
  animation: fadeInUp 0.9s ease-out 0.1s both;
}

.typewriter {
  font-family: var(--font-mono);
  font-size: 0.95rem;
  color: var(--text-muted);
  min-height: 1.6em;
  margin-bottom: 6px;
  animation: fadeInUp 0.9s ease-out 0.2s both;
}

.typewriter .cursor {
  display: inline-block;
  width: 2px;
  height: 1.2em;
  background: var(--accent);
  animation: blink 1.1s step-end infinite;
  vertical-align: text-bottom;
  margin-left: 2px;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(16px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.hero-actions {
  margin-top: 28px;
  display: flex;
  gap: 14px;
  justify-content: center;
  flex-wrap: wrap;
  animation: fadeInUp 0.9s ease-out 0.35s both;
}

.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 26px;
  border-radius: 2px;
  font-size: 0.85rem;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
  border: 1px solid transparent;
  cursor: pointer;
  font-family: var(--font-serif);
  letter-spacing: 0.05em;
}

.btn-main {
  background: var(--accent);
  color: #fff;
}

.btn-main:hover {
  filter: brightness(1.15);
  transform: translateY(-1px);
  color: #fff;
}

.btn-ghost {
  background: transparent;
  border-color: var(--border);
  color: var(--text-muted);
}

.btn-ghost:hover {
  border-color: var(--accent);
  color: var(--accent);
  transform: translateY(-1px);
}

/* Quote */
.quote {
  text-align: center;
  padding: 36px 0;
  position: relative;
  z-index: 1;
  animation: fadeInUp 0.9s ease-out 0.5s both;
}

.quote-inner {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.quote-seal {
  width: 20px;
  height: 20px;
  background: var(--accent);
  border-radius: 2px;
  opacity: 0.85;
}

.quote blockquote {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--text-main);
  border: none;
  padding: 0;
  margin: 0;
  letter-spacing: 0.1em;
}

/* Widgets */
.widgets {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  max-width: 900px;
  margin: 0 auto;
  padding: 40px 0 30px;
  position: relative;
  z-index: 1;
  animation: fadeInUp 0.9s ease-out 0.65s both;
}

.api-widgets {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 20px;
  max-width: 900px;
  margin: 0 auto;
  padding: 0 0 50px;
  position: relative;
  z-index: 1;
  animation: fadeInUp 0.9s ease-out 0.8s both;
}

.widget-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 3px;
  padding: 24px;
  position: relative;
  transition: all 0.35s cubic-bezier(0.23, 1, 0.32, 1);
}

.widget-card:hover {
  border-color: var(--border-accent);
  transform: translateY(-2px);
}

.widget-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--accent);
  opacity: 0;
  transition: opacity 0.35s ease;
}

.widget-card:hover::before {
  opacity: 0.6;
}

.widget-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.widget-header h3 {
  font-family: var(--font-serif);
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--text-main);
  margin: 0;
  display: flex;
  align-items: center;
  gap: 8px;
}

.widget-header h3 i {
  color: var(--accent);
  font-size: 0.85rem;
}

.widget-num {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--accent);
  opacity: 0.5;
  font-weight: 500;
}

.widget-content {
  color: var(--text-muted);
  font-size: 0.9rem;
}

.ip-address {
  font-family: var(--font-mono);
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 4px;
}

.ip-location {
  font-size: 0.8rem;
}

.weather-temp {
  font-family: var(--font-mono);
  font-size: 1.8rem;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 4px;
}

.weather-desc {
  font-size: 0.8rem;
}

.pomodoro-timer {
  font-family: var(--font-mono);
  font-size: 2.2rem;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 14px;
  letter-spacing: 2px;
}

.pomodoro-controls {
  display: flex;
  gap: 8px;
  justify-content: center;
}

.btn-pomo {
  padding: 7px 16px;
  border-radius: 2px;
  font-size: 0.75rem;
  font-weight: 600;
  border: 1px solid var(--border);
  background: transparent;
  color: var(--text-muted);
  cursor: pointer;
  transition: all 0.3s ease;
  font-family: var(--font-serif);
  letter-spacing: 0.05em;
}

.btn-pomo:hover {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-light);
}

.btn-pomo:active {
  transform: scale(0.97);
}

/* API Cards */
.api-card {
  text-align: left;
}

.yiyan-text {
  font-family: var(--font-serif);
  font-size: 0.95rem;
  color: var(--text-muted);
  line-height: 1.8;
  position: relative;
  padding-left: 14px;
  border-left: 2px solid var(--accent);
}

.news-date {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--accent);
  margin-bottom: 10px;
}

.news-list {
  list-style: none;
  padding: 0;
  margin: 0;
  max-height: 260px;
  overflow-y: auto;
}

.news-list::-webkit-scrollbar {
  width: 3px;
}

.news-list::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: 2px;
}

.news-list li {
  padding: 6px 0;
  border-bottom: 1px solid var(--border);
  font-size: 0.82rem;
  color: var(--text-muted);
  line-height: 1.6;
}

.news-list li:last-child {
  border-bottom: none;
}

.news-list li::before {
  content: "·";
  color: var(--accent);
  margin-right: 8px;
  font-weight: bold;
}

.news-tip {
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid var(--border);
  font-size: 0.78rem;
  color: var(--accent);
  font-style: italic;
  line-height: 1.5;
  opacity: 0.8;
}

/* Responsive */
@media (max-width: 640px) {
  .home-page {
    padding: 30px 16px;
  }
  .widgets { grid-template-columns: 1fr; }
  .api-widgets { grid-template-columns: 1fr; }
  .hero-title { font-size: 2.2rem; }
  .hero { padding: 20px 0 30px; }
  .btn { padding: 9px 20px; font-size: 0.8rem; }
  .quote blockquote { font-size: 1.1rem; }
  .pomodoro-timer { font-size: 1.8rem; }
}
</style>

<script>
(function() {
  var texts = ['just do it'];
  var textIndex = 0;
  var charIndex = 0;
  var isDeleting = false;
  var el = document.getElementById('type-text');
  if (!el) return;

  function type() {
    var current = texts[textIndex];
    if (isDeleting) {
      el.textContent = current.substring(0, charIndex - 1);
      charIndex--;
    } else {
      el.textContent = current.substring(0, charIndex + 1);
      charIndex++;
    }

    var speed = isDeleting ? 50 : 120;
    if (!isDeleting && charIndex === current.length) {
      speed = 2000;
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      textIndex = (textIndex + 1) % texts.length;
      speed = 300;
    }
    setTimeout(type, speed);
  }
  setTimeout(type, 500);
})();

(function() {
  // IP + Weather
  var ipEl = document.querySelector('.ip-address');
  var locEl = document.querySelector('.ip-location');
  var tempEl = document.querySelector('.weather-temp');
  var descEl = document.querySelector('.weather-desc');

  fetch('https://ipapi.co/json/')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (ipEl) ipEl.textContent = data.ip || '未知';
      if (locEl) locEl.textContent = (data.city || '') + '，' + (data.country_name || '');
      return fetch('https://api.open-meteo.com/v1/forecast?latitude=' + data.latitude + '&longitude=' + data.longitude + '&current_weather=true');
    })
    .then(function(r) { return r.json(); })
    .then(function(w) {
      if (w.current_weather) {
        if (tempEl) tempEl.textContent = w.current_weather.temperature + '°C';
        var codes = {
          0: '晴朗', 1: '大部晴朗', 2: '多云', 3: '阴天',
          45: '雾', 48: '雾凇',
          51: '毛毛雨', 53: '中雨', 55: '大雨',
          61: '小雨', 63: '中雨', 65: '大雨',
          71: '小雪', 73: '中雪', 75: '大雪',
          80: '阵雨', 81: '中阵雨', 82: '强阵雨',
          95: '雷雨', 96: '雷雨伴冰雹', 99: '强雷雨伴冰雹'
        };
        var desc = codes[w.current_weather.weathercode] || '未知';
        if (descEl) descEl.textContent = desc;
      }
    })
    .catch(function() {
      if (ipEl) ipEl.textContent = '获取失败';
      if (locEl) locEl.textContent = '--';
      if (tempEl) tempEl.textContent = '--';
      if (descEl) descEl.textContent = '--';
    });

  // Pomodoro
  var timerEl = document.querySelector('.pomodoro-timer');
  var startBtn = document.getElementById('pomo-start');
  var pauseBtn = document.getElementById('pomo-pause');
  var resetBtn = document.getElementById('pomo-reset');
  if (!timerEl || !startBtn || !pauseBtn || !resetBtn) return;

  var totalSeconds = 25 * 60;
  var remaining = totalSeconds;
  var interval = null;
  var isRunning = false;

  function formatTime(s) {
    var m = Math.floor(s / 60);
    var sec = s % 60;
    return (m < 10 ? '0' : '') + m + ':' + (sec < 10 ? '0' : '') + sec;
  }

  function updateDisplay() {
    timerEl.textContent = formatTime(remaining);
  }

  function start() {
    if (isRunning) return;
    isRunning = true;
    interval = setInterval(function() {
      remaining--;
      updateDisplay();
      if (remaining <= 0) {
        clearInterval(interval);
        isRunning = false;
        alert('番茄钟时间到！休息一下吧。');
        remaining = totalSeconds;
        updateDisplay();
      }
    }, 1000);
  }

  function pause() {
    if (!isRunning) return;
    clearInterval(interval);
    isRunning = false;
  }

  function reset() {
    clearInterval(interval);
    isRunning = false;
    remaining = totalSeconds;
    updateDisplay();
  }

  startBtn.addEventListener('click', start);
  pauseBtn.addEventListener('click', pause);
  resetBtn.addEventListener('click', reset);

  // 每日一言
  var yiyanEl = document.querySelector('.yiyan-text');
  if (yiyanEl) {
    fetch('https://60s.viki.moe/v2/hitokoto')
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.data && d.data.hitokoto) {
          yiyanEl.textContent = d.data.hitokoto;
        } else {
          yiyanEl.textContent = '获取失败';
        }
      })
      .catch(function() {
        yiyanEl.textContent = '获取失败';
      });
  }

  // 60s 读世界
  var newsDateEl = document.querySelector('.news-date');
  var newsListEl = document.querySelector('.news-list');
  var newsTipEl = document.querySelector('.news-tip');
  if (newsListEl) {
    fetch('https://60s.viki.moe/v2/60s')
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.data) {
          if (newsDateEl) newsDateEl.textContent = d.data.date + ' ' + (d.data.day_of_week || '');
          if (d.data.news && d.data.news.length) {
            newsListEl.innerHTML = '';
            d.data.news.forEach(function(item) {
              var li = document.createElement('li');
              li.textContent = item;
              newsListEl.appendChild(li);
            });
          } else {
            newsListEl.textContent = '暂无新闻';
          }
          if (newsTipEl && d.data.tip) newsTipEl.textContent = d.data.tip;
        }
      })
      .catch(function() {
        if (newsListEl) newsListEl.textContent = '获取失败';
      });
  }
})();
</script>
